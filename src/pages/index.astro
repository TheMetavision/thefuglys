---
import fs from 'node:fs';
import path from 'node:path';
import { PortableText } from 'astro-portabletext';
import { sanityDims, localImg, localSrcset } from '../lib/sanityImage';
import Layout from '../layouts/Layout.astro';
import { tvSeriesSchema } from '../lib/schema';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import MerchPromo from '../components/MerchPromo.astro';
import { getCoreSixCharacters, getCharacterImageLarge, getNonCoreCharacters, getCharacterImage, getWorldLocations, getWorldLocationImage, getAllBooks, getBookCoverImage, bookBuyUrl, getHomeSettings, hasPublishedEpisode, urlFor } from '../lib/sanity';

const settings = await getHomeSettings();
const positioningLine = settings?.positioningLine?.trim()
  || 'An animated dark comedy about a ragtag crew of misfits surviving in the only trailer park left in the badlands.';
const youtubeChannelUrl = settings?.youtubeChannelUrl || 'https://www.youtube.com/@TheFuglys';

// The trailer thumbnail is self-hosted so nothing loads from YouTube before play.
// A trailer ID from Sanity is used only when its thumbnail is in /video-thumbs/.
const DEFAULT_TRAILER_ID = 'XgwfSjIJre4';
const sanityTrailerId = settings?.trailerYoutubeId?.trim();
const trailerId = sanityTrailerId && /^[\w-]{6,20}$/.test(sanityTrailerId)
  && fs.existsSync(path.join(process.cwd(), 'public', 'video-thumbs', `${sanityTrailerId}.jpg`))
  ? sanityTrailerId
  : DEFAULT_TRAILER_ID;

// Series copy follows episode status so the page never claims an episode is out early.
const seriesLive = await hasPublishedEpisode();

const books = (await getAllBooks()).map((b: any) => ({
  title: b.title,
  cover: getBookCoverImage(b, 360, 540),
  comingSoon: b.status === 'coming-soon',
  buyUrl: bookBuyUrl(b),
}));
const anyBookPending = books.some((b) => !b.buyUrl);

const coreSix = await getCoreSixCharacters();
const carouselCharacters = coreSix.map((c: any) => ({
  name: c.name,
  role: c.role,
  quote: c.quote,
  image: getCharacterImageLarge(c),
}));

const nonCore = await getNonCoreCharacters(6);
const rosterCharacters = nonCore.map((c: any) => ({
  name: c.name,
  role: c.role,
  quote: c.quote ?? c.bio?.substring(0, 80) + '...',
  image: getCharacterImage(c),
  type: c.characterType,
}));

const worldLocations = await getWorldLocations();
const pitsCards = worldLocations.map((loc: any) => ({
  name: loc.title,
  slug: loc.slug,
  tagline: loc.tagline,
  image: getWorldLocationImage(loc),
  drawerImage: getWorldLocationImage(loc, 960, 544),
  alt: loc.image?.alt ?? loc.title,
  description: loc.description,
  // A card opens the drawer only once its location has a description.
  hasDrawer: Boolean(loc.slug) && Array.isArray(loc.description) && loc.description.length > 0,
  residents: loc.residents ?? [],
  products: (loc.featuredProducts ?? []).map((p: any) => ({
    name: p.name,
    slug: p.slug,
    image: p.imageUrl || (p.heroImage?.asset ? urlFor(p.heroImage).width(400).height(400).fit('crop').auto('format').url() : ''),
  })),
}));
---

<Layout title="The Fuglys" description="Wasteland Weirdos, Wild Adventures, Zero Regrets! Join The Fuglys on their wild, post-apocalyptic adventures." jsonLd={tvSeriesSchema()}>
  <Nav />

  <main>
    <section class="hero" id="hero">
      <div class="hero-tagline-bar">
        <h1 class="hero-tagline">WASTELAND WEIRDOS, <span class="hero-tagline-accent">WILD</span> ADVENTURES, ZERO REGRETS!</h1>
        <p class="hero-positioning">{positioningLine}</p>
      </div>

      <div class="hero-body">
        <div class="hero-image-col">
          {carouselCharacters.map((char, i) => (
            <img
              class={`hero-char-img${i === 0 ? ' is-active' : ''}`}
              src={char.image}
              {...sanityDims(char.image, 900)}
              alt={char.name}
              data-index={i}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          ))}
          <div class="hero-image-gradient"></div>
        </div>

        <div class="hero-info-col">
          <div class="hero-char-panel">
            {carouselCharacters.map((char, i) => (
              <div class={`hero-char-info${i === 0 ? ' is-active' : ''}`} data-index={i} aria-hidden={i !== 0 ? 'true' : 'false'}>
                <span class="char-role">{char.role}</span>
                <h2 class="char-name">{char.name}</h2>
                <p class="char-quote">"{char.quote}"</p>
              </div>
            ))}
          </div>

          <div class="hero-dots-row" id="carousel-dots" role="tablist">
            {carouselCharacters.map((char, i) => (
              <button
                class={`carousel-dot${i === 0 ? ' is-active' : ''}`}
                data-index={i}
                aria-label={`Go to ${char.name}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
              ></button>
            ))}
            <button type="button" class="carousel-pause" id="carousel-pause" aria-pressed="false">Pause</button>
          </div>

          <div class="hero-ctas">
            <a href="https://www.youtube.com/shorts/XgwfSjIJre4" target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta--solid">WATCH OUR TRAILER</a>
            <a href="/media" class="hero-cta hero-cta--outline">EXPLORE MEDIA</a>
          </div>
        </div>
      </div>

      <button class="carousel-arrow carousel-arrow--prev" id="carousel-prev" aria-label="Previous character">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="carousel-arrow carousel-arrow--next" id="carousel-next" aria-label="Next character">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <div class="hero-stats-strip">
        <div class="hero-stats-inner">
          <span class="hero-stat">30+ Characters</span>
          <span class="hero-stat-divider"></span>
          <span class="hero-stat">Post-Apocalyptic</span>
          <span class="hero-stat-divider"></span>
          <span class="hero-stat">Dark Comedy</span>
          <span class="hero-stat-divider"></span>
          <span class="hero-stat">Ages 14+</span>
        </div>
      </div>
    </section>

    <section class="section series-teaser-section">
      <div class="container">
        <div class="series-teaser-grid">
          <div class="series-thumb-col">
            <div class="series-thumb-wrap" id="seriesThumb">
              <img
                src={localImg(`/video-thumbs/${trailerId}.jpg`, 480)}
                srcset={localSrcset(`/video-thumbs/${trailerId}.jpg`, 480, 720)}
                sizes="(min-width: 900px) 480px, 100vw"
                width="720"
                height="1100"
                loading="lazy"
                alt="The Fuglys animated series trailer"
                class="series-thumb-img"
              />
              <div class="series-scanlines" aria-hidden="true"></div>
              <button class="series-play-btn" aria-label="Play trailer (loads from YouTube)">
                <svg viewBox="0 0 24 24" fill="white" width="28" height="28"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <p class="video-note">Plays from YouTube, which may set cookies.</p>
          </div>

          <div class="series-text-col">
            {seriesLive ? (
              <>
                <div class="series-eyebrow">Now Streaming</div>
                <h2 class="series-heading">The Animated Series</h2>
                <div class="series-rule"></div>
                <p class="series-body">
                  Series 1 is out now on YouTube. Pull up a crate and watch the crew make a bad day worse.
                </p>
                <div class="series-ctas">
                  <a href={youtubeChannelUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary-red">Watch Now</a>
                  <a href={`${youtubeChannelUrl}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="btn btn-outline-red">Subscribe &rarr;</a>
                </div>
              </>
            ) : (
              <>
                <div class="series-eyebrow">Trailer Out Now</div>
                <h2 class="series-heading">The Animated Series</h2>
                <div class="series-rule"></div>
                <p class="series-body">
                  Series 1 is on the way — subscribe on YouTube and you'll be first in the queue when the chaos lands.
                </p>
                <div class="series-ctas">
                  <a href={`${youtubeChannelUrl}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="btn btn-primary-red">Subscribe</a>
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <script define:vars={{ trailerId }}>
      (function () {
        // Click-to-load: nothing is requested from YouTube until the visitor
        // presses play (the thumbnail is self-hosted in /video-thumbs/).
        const wrap = document.getElementById('seriesThumb');
        if (!wrap) return;
        wrap.addEventListener('click', function () {
          wrap.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + trailerId + '?autoplay=1&rel=0" title="The Fuglys Animated Series trailer" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;inset:0;width:100%;height:100%;border-radius:4px;"></iframe>';
          wrap.querySelector('iframe')?.focus();
        });
      })();
    </script>

    <section class="section misfits-section">
      <div class="container">
        <div class="misfits-header">
          <p class="section-eyebrow">The Wider Crew</p>
          <h2 class="section-heading">Survivors, Creatures &amp; Villains</h2>
          <div class="heading-rule"></div>
        </div>

        <div class="character-grid">
          {rosterCharacters.map((char) => {
            const badgeClass = char.type === 'villain' ? 'badge--villain' : char.type === 'creature' ? 'badge--creature' : 'badge--survivor';
            const badgeLabel = char.type === 'villain' ? 'Villain' : char.type === 'creature' ? 'Creature' : 'Survivor';
            return (
              <a href="/meet-the-misfits" class="character-card">
                <div class="character-card-img-wrap">
                  <img
                    src={char.image}
                    alt={char.name}
                    class="character-card-img"
                    loading="lazy"
                  />
                </div>
                <div class="character-card-body">
                  <span class={`character-card-badge ${badgeClass}`}>{badgeLabel}</span>
                  <p class="character-card-role">{char.role}</p>
                  <p class="character-card-name">{char.name}</p>
                  <p class="character-card-quote">{char.quote}</p>
                </div>
              </a>
            );
          })}
        </div>

        <p class="misfits-footnote">That's just the start — 30+ misfits, creatures, and villains in the wasteland.</p>
        <div class="misfits-cta">
          <a href="/meet-the-misfits" class="btn btn-primary">Meet the Full Crew &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section the-pits-section" id="the-pits">
      <div class="container">
        <div class="pits-header">
          <div class="section-eyebrow">The World</div>
          <h2 class="pits-heading">Welcome to The Pits</h2>
          <div class="pits-rule"></div>
          <p class="pits-body">
            The Pits. Best trailer park in the badlands — probably the only trailer park in the badlands. We got walls. Most of 'em still standing. We got people who look out for each other. Mostly.
          </p>
        </div>

        <div class="pits-location-grid">
          {pitsCards.map((card) => card.hasDrawer ? (
            <button
              type="button"
              class="location-card location-card--image location-card--button"
              style={`background-image: url('${card.image}');`}
              data-pits-open={card.slug}
              aria-haspopup="dialog"
              aria-controls={`pits-drawer-${card.slug}`}
            >
              <span class="location-card-overlay"></span>
              <span class="location-card-marker" aria-hidden="true">+</span>
              <span class="location-card-content">
                <span class="location-card-name">{card.name}</span>
                <span class="location-card-tagline">{card.tagline}</span>
              </span>
            </button>
          ) : (
            <div
              class="location-card location-card--image"
              style={`background-image: url('${card.image}');`}
              role="img"
              aria-label={card.alt}
            >
              <div class="location-card-overlay"></div>
              <div class="location-card-content">
                <span class="location-card-name">{card.name}</span>
                <span class="location-card-tagline">{card.tagline}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {pitsCards.filter((card) => card.hasDrawer).map((card) => (
        <dialog class="pits-drawer" id={`pits-drawer-${card.slug}`} data-pits-drawer={card.slug} aria-labelledby={`pits-drawer-title-${card.slug}`}>
          <div class="pits-drawer-panel">
            <button type="button" class="pits-drawer-close" data-pits-close aria-label="Close">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
            {card.drawerImage && (
              <img class="pits-drawer-img" src={card.drawerImage} alt={card.alt} width="960" height="544" loading="lazy" />
            )}
            <div class="pits-drawer-body">
              <p class="section-eyebrow">The Pits</p>
              <h2 class="pits-drawer-title" id={`pits-drawer-title-${card.slug}`}>{card.name}</h2>
              <p class="pits-drawer-tagline">{card.tagline}</p>
              <div class="pits-drawer-desc">
                <PortableText value={card.description} />
              </div>

              {card.residents.length > 0 && (
                <div class="pits-drawer-group">
                  <h3 class="pits-drawer-subhead">Who Lives Here</h3>
                  <ul class="pits-chips">
                    {card.residents.map((r: any) => (
                      <li><a class="pits-chip" href={`/meet-the-misfits#${r.slug}`}>{r.name}</a></li>
                    ))}
                  </ul>
                </div>
              )}

              {card.products.length > 0 && (
                <div class="pits-drawer-group">
                  <h3 class="pits-drawer-subhead">Grab the Gear</h3>
                  <ul class="pits-products">
                    {card.products.map((p: any) => (
                      <li>
                        <a class="pits-product" href={`/products/${p.slug}`}>
                          {p.image && <img src={p.image} alt="" width="200" height="200" loading="lazy" />}
                          <span class="pits-product-name">{p.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </dialog>
      ))}
    </section>

    {books.length > 0 && (
    <section class="section split-section" id="books">
      <div class="container">
        <div class="split-grid">
          <div class="split-text">
            <p class="section-eyebrow books-eyebrow">The Books</p>
            <h2 class="section-heading">Chaos, Survival, and.... a Whole Lotta Trouble!</h2>
            <div class="heading-rule"></div>
            <p>
              Dive into the world of <em>The Fuglys</em>, a ragtag crew of misfits making their way
              through the wasteland with grit, humor, and just the right amount of madness.
              Packed with unpredictable twists, bizarre encounters, and unforgettable characters,
              this book series is a wild ride through a post-apocalyptic world where only the weird survive!
            </p>
            <div class="genre-tags">
              <span class="genre-tag">Dark Comedy</span>
              <span class="genre-tag">Post-Apocalyptic</span>
              <span class="genre-tag">Ages 14+</span>
              <span class="genre-tag">Gritty Humour</span>
            </div>
            {anyBookPending && (
              <a href="#newsletter" class="btn btn-teal mt-btn">Put me on the list</a>
            )}
          </div>
          <ul class="book-grid">
            {books.map((book) => (
              <li class="book-item">
                <div class="book-cover-wrap">
                  {book.cover
                    ? <img src={book.cover} alt={`${book.title} cover`} width="360" height="540" loading="lazy" class="book-cover" />
                    : <div class="book-cover book-cover--blank" aria-hidden="true"></div>}
                  {book.comingSoon && <span class="book-badge">Coming soon</span>}
                </div>
                <p class="book-title">{book.title}</p>
                {book.buyUrl && (
                  <a href={book.buyUrl} target="_blank" rel="noopener noreferrer" class="book-buy">Get the book<span class="visually-hidden"> — {book.title}</span></a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    )}

    <MerchPromo
      accent="#b3162e"
      eyebrow="Official Merch"
      heading="Rep the Wasteland"
      blurb="Character tees, hoodies and tumblers — printed on demand and shipped worldwide."
      ctaLabel="Shop the Collection"
    />

    <Newsletter />
  </main>

  <Footer />
</Layout>

<script>
  const charImgs = document.querySelectorAll<HTMLElement>('.hero-char-img');
  const charInfos = document.querySelectorAll<HTMLElement>('.hero-char-info');
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const total = charImgs.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;
  // Stopped by the Pause button, or from the start under reduced motion; hover
  // and focus pause it only while they last.
  let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let held = false;
  const pauseBtn = document.getElementById('carousel-pause');
  const heroBody = document.querySelector<HTMLElement>('.hero-body');

  function goTo(index: number) {
    charImgs[current].classList.remove('is-active');
    charInfos[current].classList.remove('is-active');
    charInfos[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('is-active');
    dots[current].setAttribute('aria-selected', 'false');

    current = (index + total) % total;

    charImgs[current].classList.add('is-active');
    charInfos[current].classList.add('is-active');
    charInfos[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('is-active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function startTimer() {
    if (timer) clearInterval(timer);
    timer = null;
    if (stopped) return;
    timer = setInterval(() => { if (!held) goTo(current + 1); }, 5000);
  }

  function paintPause() {
    if (!pauseBtn) return;
    pauseBtn.textContent = stopped ? 'Play' : 'Pause';
    pauseBtn.setAttribute('aria-pressed', String(stopped));
    pauseBtn.setAttribute('aria-label', stopped ? 'Start the character slideshow' : 'Stop the character slideshow');
  }
  pauseBtn?.addEventListener('click', () => { stopped = !stopped; paintPause(); startTimer(); });
  heroBody?.addEventListener('mouseenter', () => { held = true; });
  heroBody?.addEventListener('mouseleave', () => { held = false; });
  heroBody?.addEventListener('focusin', () => { held = true; });
  heroBody?.addEventListener('focusout', () => { held = false; });
  paintPause();

  prevBtn?.addEventListener('click', () => { goTo(current - 1); startTimer(); });
  nextBtn?.addEventListener('click', () => { goTo(current + 1); startTimer(); });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      goTo(Number(dot.dataset.index));
      startTimer();
    });
  });

  startTimer();

  // ── The Pits drawer ──────────────────────────────────────
  // Only cards with a description render as buttons (and get a <dialog>); with
  // none, this finds nothing and the section stays static.
  const PITS_HASH = '#the-pits/';
  const pitsDialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>('dialog[data-pits-drawer]').forEach((d) => {
    pitsDialogs.set(d.dataset.pitsDrawer!, d);
  });
  let pitsOpener: HTMLElement | null = null;

  function pitsCardFor(slug: string) {
    return document.querySelector<HTMLElement>(`[data-pits-open="${CSS.escape(slug)}"]`);
  }

  function openPits(slug: string, opener: HTMLElement | null) {
    const dialog = pitsDialogs.get(slug);
    if (!dialog || dialog.open) return;
    pitsDialogs.forEach((d, s) => { if (d.open) closePits(d, s); });
    pitsOpener = opener ?? pitsCardFor(slug);
    pitsOpenSlug = slug;
    dialog.showModal();
    dialog.querySelector<HTMLElement>('[data-pits-close]')?.focus();
    if (location.hash !== PITS_HASH + slug) {
      history.replaceState(null, '', PITS_HASH + slug);
    }
  }

  // Tidy up synchronously rather than waiting for the dialog's async 'close'
  // event (which a browser may defer, e.g. in a background tab); 'close' still
  // calls this as a fallback, so it must be safe to run twice.
  let pitsOpenSlug: string | null = null;
  function closePits(dialog: HTMLDialogElement, slug: string) {
    if (dialog.open) dialog.close();
    if (pitsOpenSlug !== slug) return;
    pitsOpenSlug = null;
    if (location.hash === PITS_HASH + slug) {
      history.replaceState(null, '', location.pathname + location.search);
    }
    (pitsOpener ?? pitsCardFor(slug))?.focus();
    pitsOpener = null;
  }

  pitsDialogs.forEach((dialog, slug) => {
    dialog.addEventListener('close', () => closePits(dialog, slug));
    // Esc
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); closePits(dialog, slug); });
    // A click on the dialog box itself (not the panel) is a backdrop click.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) closePits(dialog, slug); });
    dialog.querySelector('[data-pits-close]')?.addEventListener('click', () => closePits(dialog, slug));
    dialog.addEventListener('keydown', (e) => {
      // Esc is handled here too, so closing never depends on the native 'cancel'.
      if (e.key === 'Escape') { e.preventDefault(); closePits(dialog, slug); return; }
      // Keep Tab inside the drawer.
      if (e.key !== 'Tab') return;
      const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-pits-open]').forEach((card) => {
    card.addEventListener('click', () => openPits(card.dataset.pitsOpen!, card));
  });

  function openPitsFromHash() {
    if (!location.hash.startsWith(PITS_HASH)) return;
    const slug = decodeURIComponent(location.hash.slice(PITS_HASH.length));
    if (!pitsDialogs.has(slug)) return;
    pitsCardFor(slug)?.scrollIntoView({ block: 'center' });
    openPits(slug, null);
  }
  window.addEventListener('hashchange', openPitsFromHash);
  openPitsFromHash();
</script>

<style>
  .video-note {
    margin: 10px 0 0;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    text-align: center;
  }

  main {
    padding-top: 0;
  }

  .hero {
    position: relative;
    margin-top: 100px;
    height: calc(100vh - 100px);
    min-height: 600px;
    background-color: #263F44;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hero-tagline-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Size Guide — The Fuglys" description="Size guide and measurements for all The Fuglys merchandise — adult, kids and baby sizes.">
  <Nav />
  <main>
    <section class="sg">
      <div class="sg-container">
        <a href="/merch" class="sg-back">&lsaquo; Back to merch</a>
        <h1 class="sg-title">Size Guide</h1>
        <p class="sg-intro">All measurements in inches. Between sizes? Size up — our gear runs true with a regular/unisex fit.</p>

        <!-- T-Shirts -->
        <div class="sg-section">
          <h2 class="sg-heading">T-Shirts</h2>
          <p class="sg-note">Unisex Gildan 5000 heavyweight cotton tee. Regular fit. Measurements in inches.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th><th>Sleeve</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>34–37</td><td>28</td><td>15.6</td></tr>
              <tr><td>M</td><td>38–41</td><td>29</td><td>17</td></tr>
              <tr><td>L</td><td>42–45</td><td>30</td><td>18.5</td></tr>
              <tr><td>XL</td><td>46–49</td><td>31</td><td>20</td></tr>
              <tr><td>2XL</td><td>50–53</td><td>32</td><td>21.5</td></tr>
              <tr><td>3XL</td><td>54–57</td><td>33</td><td>22.8</td></tr>
              <tr><td>4XL</td><td>58–61</td><td>34</td><td>24.2</td></tr>
              <tr><td>5XL</td><td>62–65</td><td>35</td><td>25.3</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Hoodies -->
        <div class="sg-section">
          <h2 class="sg-heading">Hoodies</h2>
          <p class="sg-note">Gildan 18500 pullover hoodie with kangaroo pocket. Regular fit.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th><th>Sleeve</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>38–41</td><td>27</td><td>33.5</td></tr>
              <tr><td>M</td><td>42–45</td><td>28</td><td>34.5</td></tr>
              <tr><td>L</td><td>46–49</td><td>29</td><td>35.5</td></tr>
              <tr><td>XL</td><td>50–53</td><td>30</td><td>36.5</td></tr>
              <tr><td>2XL</td><td>54–57</td><td>31</td><td>37.5</td></tr>
              <tr><td>3XL</td><td>58–61</td><td>32</td><td>38.5</td></tr>
              <tr><td>4XL</td><td>62–65</td><td>33</td><td>39.5</td></tr>
              <tr><td>5XL</td><td>66–69</td><td>34</td><td>40.5</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Tanks -->
        <div class="sg-section">
          <h2 class="sg-heading">Vest Tanks</h2>
          <p class="sg-note">Bella+Canvas 3480 tank. Regular fit.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th></tr></thead>
            <tbody>
              <tr><td>XS</td><td>31–34</td><td>26</td></tr>
              <tr><td>S</td><td>34–37</td><td>27</td></tr>
              <tr><td>M</td><td>38–41</td><td>28</td></tr>
              <tr><td>L</td><td>42–45</td><td>29</td></tr>
              <tr><td>XL</td><td>46–49</td><td>30</td></tr>
              <tr><td>2XL</td><td>50–53</td><td>31</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Long Sleeves -->
        <div class="sg-section">
          <h2 class="sg-heading">Long Sleeves</h2>
          <p class="sg-note">Gildan 2400 long sleeve tee. Regular fit.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th><th>Sleeve</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>34–37</td><td>28</td><td>33.5</td></tr>
              <tr><td>M</td><td>38–41</td><td>29</td><td>35</td></tr>
              <tr><td>L</td><td>42–45</td><td>30</td><td>36.5</td></tr>
              <tr><td>XL</td><td>46–49</td><td>31</td><td>38</td></tr>
              <tr><td>2XL</td><td>50–53</td><td>32</td><td>39.5</td></tr>
              <tr><td>3XL</td><td>54–57</td><td>33</td><td>39.5</td></tr>
              <tr><td>4XL</td><td>58–61</td><td>34</td><td>40</td></tr>
              <tr><td>5XL</td><td>62–65</td><td>35</td><td>40.5</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Kids Tees -->
        <div class="sg-section">
          <h2 class="sg-heading">Kids T-Shirts</h2>
          <p class="sg-note">Gildan 5000B youth tee. Measurements in inches.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>Chest (flat)</th><th>Body length</th><th>Approx age</th></tr></thead>
            <tbody>
              <tr><td>XS</td><td>16</td><td>20.5</td><td>4–5</td></tr>
              <tr><td>S</td><td>17</td><td>22</td><td>6–7</td></tr>
              <tr><td>M</td><td>18</td><td>23.5</td><td>8–9</td></tr>
              <tr><td>L</td><td>19</td><td>25</td><td>10–11</td></tr>
              <tr><td>XL</td><td>20</td><td>26.5</td><td>12–13</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Kids Hoodies -->
        <div class="sg-section">
          <h2 class="sg-heading">Kids Hoodies</h2>
          <p class="sg-note">Gildan 18500B youth hoodie.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th><th>Sleeve</th><th>Approx age</th></tr></thead>
            <tbody>
              <tr><td>XS</td><td>29–33</td><td>19.75</td><td>23.5</td><td>4–5</td></tr>
              <tr><td>S</td><td>33–37</td><td>21.25</td><td>26.5</td><td>6–7</td></tr>
              <tr><td>M</td><td>37–39</td><td>22.5</td><td>27.75</td><td>8–9</td></tr>
              <tr><td>L</td><td>39–41</td><td>24</td><td>30.25</td><td>10–11</td></tr>
              <tr><td>XL</td><td>41–43</td><td>25.5</td><td>33</td><td>12–13</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Kids Long Sleeves -->
        <div class="sg-section">
          <h2 class="sg-heading">Kids Long Sleeves</h2>
          <p class="sg-note">Bella+Canvas 3501Y youth long sleeve.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>To fit chest</th><th>Body length</th><th>Approx age</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>24–27</td><td>21.1</td><td>6–7</td></tr>
              <tr><td>M</td><td>27–30</td><td>22.3</td><td>8–9</td></tr>
              <tr><td>L</td><td>31–33</td><td>23.4</td><td>10–12</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Baby Grows -->
        <div class="sg-section">
          <h2 class="sg-heading">Baby Grows</h2>
          <p class="sg-note">Rabbit Skins 4424 jersey bodysuit. Garment measurements (flat) in inches.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>Body length</th><th>Width (flat)</th><th>Approx age</th></tr></thead>
            <tbody>
              <tr><td>6M</td><td>11.75</td><td>9</td><td>3–6 months</td></tr>
              <tr><td>12M</td><td>12.75</td><td>10</td><td>6–12 months</td></tr>
              <tr><td>18M</td><td>13.75</td><td>11</td><td>12–18 months</td></tr>
              <tr><td>24M</td><td>14.75</td><td>12</td><td>18–24 months</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Socks -->
        <div class="sg-section">
          <h2 class="sg-heading">Socks</h2>
          <p class="sg-note">Cushioned sublimation socks.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Size</th><th>UK</th><th>US (M)</th><th>US (W)</th><th>EU</th></tr></thead>
            <tbody>
              <tr><td>M</td><td>5–7.5</td><td>6–8.5</td><td>7–9.5</td><td>38–41</td></tr>
              <tr><td>L</td><td>8–10.5</td><td>9–11.5</td><td>10–12.5</td><td>42–45</td></tr>
              <tr><td>XL</td><td>11–13.5</td><td>12–14.5</td><td>13–16</td><td>46–49</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- Drinkware -->
        <div class="sg-section">
          <h2 class="sg-heading">Drinkware</h2>
          <p class="sg-note">Tumblers and can glasses are one size.</p>
          <div class="sg-table-wrap"><table class="sg-table">
            <thead><tr><th>Product</th><th>Capacity</th><th>Height</th></tr></thead>
            <tbody>
              <tr><td>Tumbler</td><td>20 oz / 590 ml</td><td>—</td></tr>
              <tr><td>Can Glass</td><td>16 oz / 473 ml</td><td>5.5"</td></tr>
            </tbody>
          </table></div>
        </div>

        <!-- How to measure -->
        <div class="sg-section">
          <h2 class="sg-heading">How to Measure</h2>
          <div class="sg-measure-grid">
            <div class="sg-measure-item"><strong>Chest</strong><p>Measure around the fullest part of the chest, keeping the tape level.</p></div>
            <div class="sg-measure-item"><strong>Body length</strong><p>From the highest point of the shoulder straight down to the hem.</p></div>
            <div class="sg-measure-item"><strong>Sleeve</strong><p>From centre back of the neck to the end of the cuff.</p></div>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  main { padding-top: 96px; }
  .sg { padding: 3rem 1.5rem 6rem; background: var(--color-bg, #263F44); }
  .sg-container { max-width: 900px; margin: 0 auto; }
  .sg-back { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-condensed, 'Barlow Condensed', sans-serif); font-size: 0.8rem; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,0.7); text-decoration: none; margin-bottom: 2rem; transition: color 0.2s; }
  .sg-back:hover { color: #fff; }
  .sg-title { font-family: var(--font-condensed, 'Barlow Condensed', sans-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; text-transform: uppercase; letter-spacing: 1px; color: #fff; margin-bottom: 0.75rem; }
  .sg-intro { font-size: 1rem; line-height: 1.7; color: rgba(255,255,255,0.7); margin-bottom: 3rem; max-width: 620px; }
  .sg-section { margin-bottom: 3rem; }
  .sg-heading { font-family: var(--font-condensed, 'Barlow Condensed', sans-serif); font-size: 1.25rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary-hover, #b3162e); margin-bottom: 0.25rem; }
  .sg-note { font-size: 0.85rem; color: rgba(255,255,255,0.7); margin-bottom: 1rem; }
  .sg-table-wrap { overflow-x: auto; border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; }
  .sg-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .sg-table thead { background: #1e3238; }
  .sg-table th { padding: 0.7rem 1.1rem; text-align: left; font-family: var(--font-condensed, 'Barlow Condensed', sans-serif); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,0.7); border-bottom: 1px solid rgba(255,255,255,0.12); white-space: nowrap; }
  .sg-table td { padding: 0.6rem 1.1rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.12); }
  .sg-table tbody tr:hover { background: rgba(179,22,46,0.06); }
  .sg-table td:first-child { font-weight: 800; color: var(--color-primary-hover, #b3162e); }
  .sg-measure-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .sg-measure-item { background: #1e3238; border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; padding: 1.25rem; }
  .sg-measure-item strong { display: block; font-family: var(--font-condensed, 'Barlow Condensed', sans-serif); font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--color-primary-hover, #b3162e); margin-bottom: 0.5rem; }
  .sg-measure-item p { font-size: 0.85rem; line-height: 1.6; color: rgba(255,255,255,0.7); margin: 0; }
  @media (max-width: 768px) { .sg { padding: 2rem 1rem 4rem; } .sg-measure-grid { grid-template-columns: 1fr; } .sg-table th, .sg-table td { padding: 0.55rem 0.7rem; font-size: 0.8rem; } }
</style>

---
import { liveClient as sanityClient } from '../../lib/sanity'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

const pages = await sanityClient.fetch(
  `*[_type == "legalPage"] | order(order asc){ title, slug, summary, lastUpdated }`
)

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<Layout
  title="Legal · The Fuglys"
  description="Privacy, cookies, terms, returns, shipping and acceptable use — everything legal in one place."
>
  <Nav />
  <section class="legal-index">
    <header class="legal-index__header">
      <p class="legal-index__eyebrow">Legal</p>
      <h1>The boring (but important) bit</h1>
      <p class="legal-index__lede">
        Everything you need to know about how the site works, how we handle
        your data, and what to do if something goes sideways.
      </p>
    </header>

    <ul class="legal-index__list">
      {pages.map((p: any) => (
        <li>
          <a href={`/legal/${p.slug.current}`} class="legal-index__card">
            <h2>{p.title}</h2>
            {p.summary && <p>{p.summary}</p>}
            <span class="legal-index__updated">Updated {fmt(p.lastUpdated)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Footer />
</Layout>

<style>
  .legal-index {
    max-width: 880px;
    margin: 0 auto;
    padding: 8rem 1.25rem 6rem;
    color: #f5f5f5;
  }
  .legal-index__header { margin-bottom: 3rem; }
  .legal-index__eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #99132F;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .legal-index__header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  .legal-index__lede {
    font-size: 1.125rem;
    color: #aaa;
    max-width: 60ch;
    margin: 0;
  }
  .legal-index__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  .legal-index__card {
    display: block;
    padding: 1.5rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .legal-index__card:hover {
    transform: translateY(-2px);
    border-color: #99132F;
  }
  .legal-index__card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .legal-index__card p {
    margin: 0 0 0.75rem;
    color: #aaa;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .legal-index__updated {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #aaa;
  }
</style>
---
import type { GetStaticPaths } from 'astro'
import { liveClient as sanityClient } from '../../lib/sanity'
import { PortableText } from 'astro-portabletext'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'

export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await sanityClient.fetch(
    `*[_type == "legalPage" && defined(slug.current)]{ slug }`
  )
  return pages.map((p: any) => ({ params: { slug: p.slug.current } }))
}

const { slug } = Astro.params

const page = await sanityClient.fetch(
  `*[_type == "legalPage" && slug.current == $slug][0]{
    _id, title, summary, effectiveDate, lastUpdated, body, noIndex
  }`,
  { slug }
)

if (!page) return Astro.redirect('/404')

const siblings = await sanityClient.fetch(
  `*[_type == "legalPage" && slug.current != $slug] | order(order asc){ title, slug }`,
  { slug }
)

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<Layout
  title={`${page.title} · The Fuglys`}
  description={page.summary}
  noIndex={page.noIndex}
>
  <Nav />
  <article class="legal">
    <header class="legal__header">
      <p class="legal__eyebrow">Legal</p>
      <h1 class="legal__title">{page.title}</h1>
      {page.summary && <p class="legal__summary">{page.summary}</p>}
      <dl class="legal__meta">
        <div>
          <dt>Effective</dt>
          <dd>{fmt(page.effectiveDate)}</dd>
        </div>
        <div>
          <dt>Last updated</dt>
          <dd>{fmt(page.lastUpdated)}</dd>
        </div>
      </dl>
    </header>

    <div class="legal__body">
      <PortableText value={page.body} />
    </div>

    {siblings.length > 0 && (
      <nav class="legal__siblings" aria-label="Other legal pages">
        <h2>Other legal pages</h2>
        <ul>
          {siblings.map((s: any) => (
            <li>
              <a href={`/legal/${s.slug.current}`}>{s.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
  <Footer />
</Layout>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: 8rem 1.25rem 6rem;
    color: #f5f5f5;
  }
  .legal__header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .legal__eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #99132F;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .legal__title {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  .legal__summary {
    font-size: 1.125rem;
    color: #aaa;
    margin: 0 0 1.5rem;
  }
  .legal__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 0;
    font-size: 0.875rem;
  }
  .legal__meta dt {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    color: #aaa;
    margin-bottom: 0.25rem;
  }
  .legal__meta dd {
    margin: 0;
    font-weight: 600;
  }
  .legal__body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .legal__body :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }
  .legal__body :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .legal__body :global(p) { margin: 0 0 1rem; }
  .legal__body :global(ul),
  .legal__body :global(ol) { padding-left: 1.5rem; margin: 0 0 1.25rem; }
  .legal__body :global(li) { margin-bottom: 0.4rem; }
  .legal__body :global(a) {
    color: #99132F;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal__body :global(blockquote) {
    border-left: 3px solid #99132F;
    padding: 0.75rem 1.25rem;
    margin: 1.25rem 0;
    background: rgba(255,255,255,0.04);
    font-style: italic;
  }
  .legal__body :global(code) {
    background: rgba(255,255,255,0.06);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    font-size: 0.92em;
  }
  .legal__siblings {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .legal__siblings h2 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #aaa;
    margin: 0 0 1rem;
  }
  .legal__siblings ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .legal__siblings a {
    color: #f5f5f5;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .legal__siblings a:hover {
    color: #99132F;
  }
</style>
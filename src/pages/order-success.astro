---
/**
 * src/pages/order-success.astro  (The Fuglys)
 *
 * Post-checkout landing page. Stripe redirects here after payment with
 * ?session_id=... — which triggers the cart clear. Uses the site's global
 * tokens + .btn classes so it matches the rest of The Fuglys.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Order Confirmed" description="Your Fuglys order is locked in." noIndex={true}>
  {/* Empty the cart once Stripe redirects back with a session_id.
      is:inline so it runs during parse, before the CartDrawer island hydrates. */}
  <script is:inline>
    if (new URLSearchParams(window.location.search).get('session_id')) {
      try { localStorage.removeItem('fuglys-cart-v1'); } catch (e) {}
    }
  </script>
  {/* The order reference: "#" + the last 8 characters of the session id,
      upper-cased, as in the confirmation email and the Sanity order. It is
      what /returns asks for. Shown once the page has loaded. */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var id = new URLSearchParams(window.location.search).get('session_id') || '';
      var box = document.getElementById('order-ref');
      var code = document.getElementById('order-ref-code');
      if (box && code && /^cs_[A-Za-z0-9_]{8,}$/.test(id)) {
        code.textContent = '#' + id.slice(-8).toUpperCase();
        box.hidden = false;
      }
    });
  </script>

  <section class="oc-section">
    <div class="oc-inner">
      <div class="oc-check">&#10003;</div>
      <h1 class="oc-title">Order Locked In</h1>
      <div class="heading-rule oc-rule"></div>
      <p class="oc-ref" id="order-ref" hidden>Order ref <strong id="order-ref-code"></strong></p>
      <p class="oc-body">
        Thanks for the haul. A confirmation email is on its way, and we'll send
        tracking the moment your gear ships out of the wasteland.
      </p>
      <div class="oc-actions">
        <a href="/merch" class="btn btn-primary">Keep Scavenging</a>
        <a href="/" class="btn btn-outline">Back to Base</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .oc-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    text-align: center;
  }
  .oc-inner { max-width: 520px; }
  .oc-check {
    font-size: 64px;
    line-height: 1;
    color: var(--color-primary-hover);
    margin-bottom: 20px;
  }
  .oc-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-text);
    margin-bottom: 16px;
  }
  .oc-rule { margin: 0 auto 24px; }
  .oc-ref { margin: 0 0 16px; color: var(--color-text-muted); font-size: 0.95rem; }
  .oc-ref strong { color: var(--color-text); letter-spacing: 1px; font-size: 1.1rem; }
  .oc-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 32px;
  }
  .oc-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { getAllProducts, urlFor } from '../lib/sanity';

const products = await getAllProducts();

/* Card image: prefer the Sanity heroImage; fall back to the first variant's
   first colour mockup (a plain Printful URL), then the variant thumbnail. */
function cardImage(p) {
  if (p.heroImage) {
    try { return urlFor(p.heroImage).width(600).height(600).fit('crop').url(); } catch (_) {}
  }
  const v = p.variants?.[0];
  return v?.colourImages?.[0]?.imageUrl || v?.printfulImageUrl || '';
}
---

<Layout title="Merch" description="Official The Fuglys merch — apparel, accessories and collectibles dragged straight out of the wasteland.">
  <Nav />

  <main class="merch-main">

    <section class="hero-banner">
      <div class="hero-noise"></div>
      <div class="container hero-inner">
        <p class="hero-eyebrow">Official Merch Drop</p>
        <h1 class="hero-title">Wasteland Gear</h1>
        <p class="hero-sub">Rep the wasteland.</p>
      </div>
    </section>

    <section class="section products-section">
      <div class="container">
        <div class="section-header">
          <div class="header-rule"></div>
          <h2 class="section-title">The Goods</h2>
          <div class="header-rule"></div>
        </div>

        {products.length === 0 ? (
          <p class="empty-note">New gear incoming. Check back soon.</p>
        ) : (
          <div class="products-grid">
            {products.map((p) => (
              <a class="product-card fade-in" href={`/product/${p.slug}`}>
                <div class="card-worn-edge top-edge"></div>
                <div class="card-worn-edge bottom-edge"></div>

                <div class="product-thumb">
                  <div class="thumb-bg-noise"></div>
                  <img class="product-img" src={cardImage(p)} alt={p.name} loading="lazy" />
                </div>

                <div class="product-info">
                  <h3>{p.name}</h3>
                  <p class="product-desc">{p.tagline || p.backstory}</p>
                  <div class="product-footer">
                    <span class="product-price">{p.fromPrice ? `from £${p.fromPrice.toFixed(2)}` : ''}</span>
                    <span class="shop-btn">Shop</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <Newsletter />

  </main>

  <Footer />
</Layout>

<style>
  /* Fuglys tokens: bg #263F44 · surface #1e3238 · accent #99132f / hover #b3162e
     · text #fff. Display = Barlow Condensed, card titles = Bebas Neue. */
  .merch-main { background: var(--color-bg); }

  /* ── HERO ── */
  .hero-banner { position: relative; padding: 120px 0 80px; background: #1e3238; text-align: center; overflow: hidden; }
  .hero-noise { position: absolute; inset: 0; background:
      radial-gradient(ellipse at 30% 50%, rgba(179,22,46,0.18) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 30%, rgba(153,19,47,0.10) 0%, transparent 50%); pointer-events: none; }
  .hero-inner { position: relative; }
  .hero-eyebrow { font-family: var(--font-condensed); font-weight: 700; font-size: 0.9rem; letter-spacing: 5px; color: var(--color-primary-hover); text-transform: uppercase; margin-bottom: 12px; }
  .hero-title { font-family: var(--font-condensed); font-weight: 900; font-size: clamp(3.5rem, 9vw, 8rem); color: #fff; line-height: 0.95; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px;
      text-shadow: 4px 4px 0 rgba(153,19,47,0.5), 8px 8px 0 rgba(153,19,47,0.2), 0 0 60px rgba(179,22,46,0.25); }
  .hero-sub { font-family: var(--font-condensed); font-weight: 700; font-size: 1.1rem; color: rgba(255,255,255,0.55); letter-spacing: 3px; text-transform: uppercase; }

  /* ── PRODUCTS ── */
  .products-section { background: var(--color-bg); padding: 100px 0; }
  .section-header { display: flex; align-items: center; gap: 24px; margin-bottom: 60px; }
  .header-rule { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(179,22,46,0.5) 60%); }
  .header-rule:last-child { background: linear-gradient(270deg, transparent, rgba(179,22,46,0.5) 60%); }
  .section-title { font-family: var(--font-condensed); font-weight: 900; font-size: clamp(2rem, 4vw, 3.5rem); color: #fff; letter-spacing: 2px; white-space: nowrap; text-transform: uppercase; text-shadow: 0 0 30px rgba(179,22,46,0.3); }
  .empty-note { text-align: center; color: var(--color-text-muted); font-family: var(--font-condensed); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }

  .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 32px; }

  .product-card { position: relative; background: var(--color-surface); border: 1px solid rgba(179,22,46,0.18); overflow: visible; transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none; display: block; }
  .card-worn-edge { position: absolute; left: -2px; right: -2px; height: 4px; z-index: 2; background: var(--color-bg);
    clip-path: polygon(0% 0%,3% 100%,6% 0%,9% 100%,12% 0%,15% 100%,18% 0%,21% 100%,24% 0%,27% 100%,30% 0%,33% 100%,36% 0%,39% 100%,42% 0%,45% 100%,48% 0%,51% 100%,54% 0%,57% 100%,60% 0%,63% 100%,66% 0%,69% 100%,72% 0%,75% 100%,78% 0%,81% 100%,84% 0%,87% 100%,90% 0%,93% 100%,96% 0%,100% 100%,100% 0%); }
  .top-edge { top: -2px; }
  .bottom-edge { bottom: -2px; transform: rotate(180deg); }
  .product-card:hover { transform: translateY(-8px) rotate(-0.3deg); box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 0 1px rgba(179,22,46,0.35), 0 0 30px rgba(179,22,46,0.15); }

  .product-thumb { position: relative; aspect-ratio: 1; overflow: hidden; background: #16262b; }
  .thumb-bg-noise { position: absolute; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 300 300' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.08'/%3E%3C/svg%3E"); background-size: 200px 200px; pointer-events: none; }
  .product-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .product-info { padding: 20px 22px 22px; border-top: 1px solid rgba(179,22,46,0.12); }
  .product-info h3 { font-family: var(--font-display); font-size: 1.5rem; color: #fff; letter-spacing: 1px; margin-bottom: 6px; text-transform: none; }
  .product-desc { font-size: 0.86rem; color: var(--color-text-subtle); margin-bottom: 16px; line-height: 1.5; min-height: 2.4em; }
  .product-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .product-price { font-family: var(--font-display); font-size: 1.5rem; color: #fff; letter-spacing: 1px; }
  .shop-btn { font-family: var(--font-condensed); font-weight: 700; font-size: 0.78rem; letter-spacing: 2px; text-transform: uppercase; color: var(--color-primary-hover); border: 1px solid rgba(179,22,46,0.45); padding: 6px 16px; transition: all 0.25s ease; }
  .product-card:hover .shop-btn { background: var(--color-primary); border-color: var(--color-primary-hover); color: #fff; box-shadow: 0 0 12px rgba(179,22,46,0.25); }

  @media (max-width: 768px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>

---
import { liveClient as sanityClient } from '../lib/sanity'
const links = await sanityClient.fetch(`*[_type == "legalPage" && showInFooter == true] | order(order asc){ title, slug }`)
---
<nav aria-label="Legal">
  <ul class="legal-links-list">
    {links.map((l) => (
      <li><a href={`/legal/${l.slug.current}`}>{l.title}</a></li>
    ))}
  </ul>
</nav>

<style>
  .legal-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .legal-links-list a {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    display: block;
    padding: 4px 0;
    transition: color 0.2s ease;
  }
  .legal-links-list a:hover {
    color: #ffffff;
  }
</style>
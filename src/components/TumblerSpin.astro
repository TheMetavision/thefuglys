---
// TumblerSpin.astro — framework-agnostic 360° spin for cylindrical products
// (tumblers, glasses, mugs). Wraps a flat print-file image around a canvas
// cylinder over a solid base colour, auto-rotates, drag to spin, and lazy-starts
// only when scrolled into view. No dependencies, no React — drops into any .astro
// page regardless of what the rest of the site uses.
//
// Usage:
//   import TumblerSpin from "../components/TumblerSpin.astro";
//   <TumblerSpin image={wrapUrl} fallback={mockupUrl} alt="Zeke 20oz Tumbler" />
//
//   image     flat wrap artwork — the *-tumbler-cover.png on the Sanity CDN
//             (transparent margins are fine; they show the base colour)
//   fallback  static mockup shown until the canvas is ready / if the image fails
//   base      cylinder colour behind the artwork (default white)
//   width/height  canvas resolution (CSS scales it responsively)
const {
  image,
  fallback,
  alt = "Product, rotating view",
  base = "#ffffff",
  width = 420,
  height = 520,
} = Astro.props;
---
<div class="tumbler-spin" data-image={image} data-base={base} style="position:relative;display:inline-block;max-width:100%;">
  <canvas
    class="tumbler-spin__cv"
    width={width}
    height={height}
    role="img"
    aria-label={alt}
    style="touch-action:none;cursor:grab;display:block;max-width:100%;height:auto;"></canvas>
  {fallback && (
    <img
      class="tumbler-spin__fallback"
      src={fallback}
      alt={alt}
      loading="lazy"
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;"
    />
  )}
</div>

<script>
  function initTumbler(root) {
    const cv = root.querySelector(".tumbler-spin__cv");
    const fb = root.querySelector(".tumbler-spin__fallback");
    if (!cv || cv.dataset.ready) return;
    cv.dataset.ready = "1";
    const ctx = cv.getContext("2d");
    const W = cv.width, H = cv.height, cx = W / 2;
    const base = root.dataset.base || "#ffffff";
    const topY = Math.round(H * 0.18), botY = Math.round(H * 0.93), bodyH = botY - topY;
    const R = Math.round(W * 0.32);
    let angle = 0, speed = 0.0055, dragging = false, lastX = 0, raf = 0, ready = false;
    const img = new Image();
    img.onload = () => { ready = true; if (fb) fb.style.display = "none"; };
    img.src = root.dataset.image;

    function rr(c, x, y, w, h, r) { c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r); c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath(); }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      if (!ready) return;
      ctx.fillStyle = "rgba(0,0,0,0.16)"; ctx.beginPath(); ctx.ellipse(cx, botY + 10, R * 0.92, 10, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = "#23232a"; rr(ctx, cx - R - 8, topY - 36, (R + 8) * 2, 28, 8); ctx.fill();
      ctx.fillStyle = "#34343d"; rr(ctx, cx - R - 3, topY - 14, (R + 3) * 2, 15, 6); ctx.fill();
      const iw = img.naturalWidth, ih = img.naturalHeight, cols = 220;
      for (let i = 0; i <= cols; i++) {
        const xRel = (i / cols) * 2 - 1;
        const phi = Math.asin(Math.max(-1, Math.min(1, xRel)));
        const u = ((phi / Math.PI + 0.5 + angle) % 1 + 1) % 1;
        const sx = Math.min(iw - 1, Math.floor(u * iw));
        const dx = cx + xRel * R;
        const sw = (R * 2) / cols + 1.2;
        ctx.fillStyle = base; ctx.fillRect(dx - sw / 2, topY, sw, bodyH);
        ctx.drawImage(img, sx, 0, 1, ih, dx - sw / 2, topY, sw, bodyH);
        const shade = Math.cos(phi);
        ctx.fillStyle = "rgba(0,0,0," + (0.55 * (1 - shade)) + ")"; ctx.fillRect(dx - sw / 2, topY, sw, bodyH);
        const hi = Math.max(0, 1 - Math.abs(xRel + 0.32) * 3.2);
        if (hi > 0) { ctx.fillStyle = "rgba(255,255,255," + (0.20 * hi) + ")"; ctx.fillRect(dx - sw / 2, topY, sw, bodyH); }
      }
      ctx.strokeStyle = "rgba(255,255,255,0.16)"; ctx.lineWidth = 2; ctx.beginPath(); ctx.ellipse(cx, topY, R, 8, 0, 0, Math.PI * 2); ctx.stroke();
      ctx.strokeStyle = "rgba(0,0,0,0.22)"; ctx.beginPath(); ctx.ellipse(cx, botY, R, 8, 0, 0, Math.PI * 2); ctx.stroke();
    }
    function loop() { if (!dragging) angle = (angle + speed) % 1; draw(); raf = requestAnimationFrame(loop); }
    function start() { if (!raf) loop(); }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

    cv.addEventListener("pointerdown", (e) => { dragging = true; lastX = e.clientX; cv.setPointerCapture(e.pointerId); cv.style.cursor = "grabbing"; });
    cv.addEventListener("pointermove", (e) => { if (!dragging) return; const dx = e.clientX - lastX; lastX = e.clientX; angle = ((angle - dx / 320) % 1 + 1) % 1; if (!raf) draw(); });
    cv.addEventListener("pointerup", () => { dragging = false; cv.style.cursor = "grab"; });
    cv.addEventListener("pointercancel", () => { dragging = false; });

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((es) => { es.forEach((en) => (en.isIntersecting ? start() : stop())); }, { threshold: 0.1 });
      io.observe(cv);
    } else { start(); }
  }
  const boot = () => document.querySelectorAll(".tumbler-spin").forEach(initTumbler);
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
